# Copy this file to .env and fill in real values. .env is gitignored.

# Neo4j Desktop: open your database, click "..." > "Connection details" for the URI,
# and use the DB user/password you set when creating the database.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Google AI Studio free-tier key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
